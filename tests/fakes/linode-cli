#!/usr/bin/env bash
# Fake `linode-cli` for offline bats tests. Records every invocation to
# $FAKE_LINODE_LOG and emits canned JSON/text so provisioning + teardown logic
# can be exercised with no Linode account. Behaviour is driven by env vars the
# tests set, so a single fake covers create / list / delete / error paths.
#
# Supported (extend as phases need): object-storage clusters-list, buckets-list,
# keys-list, keys-create, keys-delete, and `obj` mb/rb. Unknown subcommands exit 0
# with empty output (so callers that probe optional features don't crash).
set -euo pipefail

LOG="${FAKE_LINODE_LOG:-/dev/null}"
printf '%s\n' "$*" >> "$LOG"

# Force a specific exit code / stderr to simulate API errors (e.g. the 400/500
# the real CLI returns for a bad --regions value).
if [[ -n "${FAKE_LINODE_FAIL:-}" ]]; then
  echo "${FAKE_LINODE_STDERR:-fake linode-cli forced failure}" >&2
  exit "${FAKE_LINODE_FAIL}"
fi

emit() { printf '%s' "$1"; }

# Canned JSON defaults. Hoisted into variables because literal `}` inside a
# ${VAR:-default} word terminates the expansion early and corrupts the JSON.
# region column is the REGION id (us-iad), distinct from cluster id (us-iad-1).
DEF_CLUSTERS='[{"id":"us-ord-1","region":"us-ord","status":"available"}]'
DEF_BUCKET_CREATE='[{"label":"fake-bucket","region":"us-ord"}]'
DEF_KEY_CREATE='[{"id":4242,"access_key":"FAKEACCESS","secret_key":"FAKESECRET"}]'

case "$1 ${2:-}" in
  "object-storage clusters-list")
    emit "${FAKE_OBJ_CLUSTERS:-$DEF_CLUSTERS}"
    ;;
  "object-storage buckets-list")
    emit "${FAKE_OBJ_BUCKETS:-[]}"
    ;;
  "object-storage buckets-create")
    emit "${FAKE_OBJ_BUCKET_CREATE:-$DEF_BUCKET_CREATE}"
    ;;
  "object-storage buckets-delete")
    emit ""
    ;;
  "object-storage keys-list")
    emit "${FAKE_OBJ_KEYS:-[]}"
    ;;
  "object-storage keys-create")
    # Mint a deterministic fake key pair so Secret emission is testable.
    emit "${FAKE_OBJ_KEY_CREATE:-$DEF_KEY_CREATE}"
    ;;
  "object-storage keys-delete")
    emit ""
    ;;
  *)
    emit "${FAKE_LINODE_DEFAULT_OUT:-}"
    ;;
esac
